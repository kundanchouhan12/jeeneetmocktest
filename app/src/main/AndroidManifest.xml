<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:name=".MockTestApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="JEE NEET Mock Test"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MockTest"
        android:usesCleartextTraffic="false">

        <!-- Ensure OCR models are downloaded at install time -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- ... -->
        <!-- ★ Replace with your real AdMob App ID from admob.google.com -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3519378438987564~1853329297" />

        <!-- Optimize ad loading -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <!-- Meta (Facebook) Audience Network — required for mediation -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.simulation.SimulationIntroActivity" android:screenOrientation="portrait" />
        <activity android:name=".ui.bookmarks.BookmarksActivity" android:screenOrientation="portrait" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity
            android:name=".ui.test.TestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false" />

        <activity
            android:name=".ui.achievements.AchievementsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.auth.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.insights.InsightsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.analysis.AnalysisActivity"
            android:exported="false" />

        <activity
            android:name=".ui.result.SolutionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.ShopActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.MockTestListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.ChapterwiseListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.doubts.ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.doubts.AISolutionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.notes.NotesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.leaderboard.LeaderboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.streak.StreakCalendarActivity"
            android:exported="false" />

        <activity
            android:name=".ui.vault.VaultDiscussionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.power100.Power100Activity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.power100.Power100ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>

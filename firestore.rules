rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Daily Vault: metadata & questions are read-only for users (written by admin pipeline)
    match /daily_vaults/{vaultId} {
      allow read: if true;
      allow write: if false;

      // Vault Community Discussions: students can chat & ask doubts
      match /discussions/{commentId} {
        allow read: if true;

        // Creating a comment: requires auth, payload length limits, uid verification
        allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.message.size() <= 300
          && request.resource.data.username.size() <= 30
          && request.resource.data.timestamp > 0;

        // Only comment author can delete
        allow delete: if isAuth() && resource.data.userId == request.auth.uid;

        // Only 'likes' count or 'isReported' flag can be updated by other students
        allow update: if isAuth() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReported', 'likes'])
        );
      }

      // Vault question poll/vote: students vote on question quality/difficulty
      match /question_votes/{userId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == userId;
      }
    }

    // User profiles & all nested subcollections (purchases, question_history, bookmarks)
    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }

    // Weekly Leaderboard: public read so all students (including guests) see rankings
    match /leaderboard/{weekKey} {
      allow read: if true;

      match /scores/{userId} {
        allow read: if true;
        allow write: if isAuth() && request.auth.uid == userId;
      }
    }

    // Question Bank: public read so all students (including guest mode) can sync questions;
    // writes strictly forbidden (written exclusively by backend Python pipelines via Admin SDK).
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // Metadata (question_bank version counter, exam_dates countdown banner)
    match /metadata/{metadataId} {
      allow read: if true;
      allow write: if false;
    }

    // App config (version control, feature flags, maintenance mode)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Daily active attempt counter (used for FOMO / social proof banners)
    match /dailyStats/{date} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Power 100 standard curated tests for JEE and NEET
    match /standard_tests/{exam} {
      allow read: if true;
      allow write: if false;
    }
  }
}

